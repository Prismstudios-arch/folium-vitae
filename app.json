{
  "expo": {
    "name": "Sorrel",
    "slug": "sorrel",
    "scheme": "sorrel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C2A1F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prismstudios.sorrel",
      "infoPlist": {
        "NSCameraUsageDescription": "Sorrel uses your camera to identify plants from photos.",
        "NSPhotoLibraryUsageDescription": "Sorrel uses your photo library to identify plants you have already photographed."
      }
    },
    "android": {
      "package": "com.prismstudios.sorrel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C2A1F"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Sorrel uses your camera to identify plants from photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sorrel uses your photo library to identify plants you have already photographed."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0C2A1F"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://folium-vitae-production-c68c.up.railway.app"
    }
  }
}
