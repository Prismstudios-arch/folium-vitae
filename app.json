{
  "expo": {
    "name": "Sorrel",
    "slug": "sorrel",
    "scheme": "sorrel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prismstudios.sorrel",
      "infoPlist": {
        "NSCameraUsageDescription": "Sorrel uses your camera to identify plants, check their health, and add photos to your plant journal.",
        "NSPhotoLibraryUsageDescription": "Sorrel uses your photo library to identify plants from photos you have already taken, and to add them to your plant journal.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.prismstudios.sorrel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05261B"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Sorrel uses your camera to identify plants, check their health, and add photos to your plant journal.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sorrel uses your photo library to identify plants from photos you have already taken, and to add them to your plant journal."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F7A57"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#05261B",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#05261B"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://folium-vitae-production-c68c.up.railway.app",
      "revenueCatPublicKey": "appl_oFUAdIkyOXQLsIBAaZbXKpBTjiq",
      "router": {},
      "eas": {
        "projectId": "7869f0a3-126e-4f69-b3ad-3f4c2df3bdc9"
      }
    },
    "owner": "jonnywilson"
  }
}
