# Verdure Phase 2 Environment Configuration

# ====================
# Backend API
# ====================
# Production
VERDURE_API_URL=https://api.verdure.app

# Development / Local
# VERDURE_API_URL=http://localhost:3000

# ====================
# Kindwise Plant ID API
# ====================
# Get your API key from: https://plant.id/api/user/login
KINDWISE_API_KEY=your_api_key_here
KINDWISE_API_SECRET=optional_secret_here
KINDWISE_BASE_URL=https://plant.id/api/v3

# ====================
# Firebase (Phase 2+)
# ====================
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ====================
# AWS S3 (Photo Storage)
# ====================
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=verdure-photos

# ====================
# Push Notifications
# ====================
# APNs (iOS)
# APNS_KEY_ID=your_key_id
# APNS_TEAM_ID=your_team_id
# APNS_BUNDLE_ID=com.verdure.app
# APNS_KEY_PATH=./path/to/key.p8

# FCM (Android)
# FCM_SERVER_KEY=your_server_key

# ====================
# Database
# ====================
# PostgreSQL Connection
# DATABASE_URL=postgresql://user:password@localhost:5432/verdure
# REDIS_URL=redis://localhost:6379

# ====================
# Authentication
# ====================
# JWT Secret for signing tokens
# JWT_SECRET=your_super_secret_key_here_keep_it_safe
# JWT_EXPIRY=1h
# REFRESH_TOKEN_EXPIRY=7d

# ====================
# Stripe (Payments)
# ====================
# STRIPE_PUBLIC_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ====================
# Email (SendGrid)
# ====================
# SENDGRID_API_KEY=SG.your_api_key_here
# SENDGRID_FROM_EMAIL=noreply@verdure.app

# ====================
# Analytics
# ====================
# MIXPANEL_TOKEN=your_token_here
# SENTRY_DSN=your_sentry_dsn_here

# ====================
# Environment
# ====================
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# ====================
# CORS
# ====================
CORS_ORIGIN=*
# For production: CORS_ORIGIN=https://verdure.app

# ====================
# Feature Flags
# ====================
ENABLE_DISEASE_DETECTION=true
ENABLE_EXPERT_ESCALATION=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_PHOTO_JOURNAL=true
